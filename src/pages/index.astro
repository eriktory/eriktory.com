---
import Layout from '../layouts/Layout.astro';
import Main from '../components/Main.astro';
---

<Layout>
	<Main class="p-4 max-w-screen-xl mx-auto">
		<section id="hero">
			<h1 class="text-3xl font-bold mb-4">Bienvenido</h1>
			<p class="text-lg mb-6">Esta es la pagina principal.</p>
		</section>

		<section id="about" class="mt-12">
			<h2 class="text-2xl font-bold mb-4">Sobre este proyecto</h2>
			<p>Construido con Astro, React, Tailwind CSS y TypeScript.</p>
		</section>
	</Main>
</Layout>
