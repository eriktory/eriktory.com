---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
---

<Layout
  title="Página no encontrada — Erik Tory"
  description="La página que buscas no existe o cambió de lugar."
>
  <Header />
  <main id="main-content" class="flex-1 w-full flex items-center justify-center px-4 py-24">
    <div class="max-w-md text-center">
      <p class="text-sm font-semibold tracking-widest text-blue-600 uppercase">Error 404</p>
      <h1 class="mt-4 text-4xl font-bold text-slate-900">Página no encontrada</h1>
      <p class="mt-4 text-slate-600">La página que buscas no existe o cambió de lugar.</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center rounded-full bg-[#0F2851] px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#1a497a]"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
