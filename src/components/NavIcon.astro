---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
	id="header-icon-container"
	class={`bg-magenta-500 p-4 sm:order-3 sm:justify-self-end flex justify-end ${className}`}
>
	<svg id="header-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path id="header-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
	</svg>
</div>
