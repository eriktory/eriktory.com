---
import ButtonCTA from '../Aux/ButtonCTA.astro';
import Logo from './Logo/Logo.astro';
import Nav from './Nav/Nav.astro';
import NavMenu from './Nav/NavMenu.astro';
---

<header class="h-12 sm:h-16 w-full bg-[#F8FAFC] border-b border-slate-100 flex flex-col sm:flex-row items-stretch">
	<div class="h-full flex items-center order-1 sm:order-1 flex-1"><Logo /></div>
	<div class="h-full flex items-center order-3 sm:order-3 justify-end"><Nav /></div>
	<div class="h-full flex items-center order-2 sm:order-2 w-full sm:w-auto justify-center sm:mx-0"><ButtonCTA /></div>
</header>
