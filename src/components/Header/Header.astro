---
import ButtonCTA from '../Aux/ButtonCTA.astro';
import Logo from './Logo/Logo.astro';
import Nav from './Nav/Nav.astro';
import NavMenu from './Nav/NavMenu.astro';
---

<header class="absolute inset-x-0 top-0 z-30 h-14 w-full px-2 sm:px-8 grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_auto_1fr] items-stretch">
  <div id="header-logo" class="col-start-1 h-full justify-self-start">
    <Logo />
  </div>

  <div id="header-cta" class="hidden sm:flex sm:col-start-2 h-full items-center justify-center">
    <ButtonCTA />
  </div>

  <div id="header-nav" class="col-start-2 sm:col-start-3 h-full flex items-center justify-self-end">
    <Nav />
  </div>

  <NavMenu />
</header>