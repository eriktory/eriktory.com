---
import ButtonCTA from '../Aux/ButtonCTA.astro';
import Logo from './Logo/Logo.astro';
import Nav from './Nav/Nav.astro';
import NavMenu from './Nav/NavMenu.astro';
---

<header class="absolute inset-x-0 top-0 z-30 h-12 sm:h-14 w-full grid grid-cols-12 items-stretch">
  <div id="header-logo" class="h-full col-span-3">
    <Logo />
  </div>
  <div id="header-cta" class="h-full col-span-8 flex items-center justify-center">
    <ButtonCTA />
  </div>
  <div id="header-nav" class="h-full col-span-1 flex items-center justify-center">
    <Nav />
  </div>
  <NavMenu />
</header>
