---
import ButtonCTA from '../Aux/ButtonCTA.astro';
import Logo from './Logo/Logo.astro';
import Nav from './Nav/Nav.astro';
import NavMenu from './Nav/NavMenu.astro';
---

<header class="absolute inset-x-0 top-0 z-30 h-12 sm:h-14 w-full grid grid-cols-2 sm:grid-cols-[1fr_auto_1fr] items-stretch">
  <div id="header-logo" class="h-full justify-self-start">
    <Logo />
  </div>

  <div id="header-cta" class="hidden sm:flex h-full items-center justify-center">
    <ButtonCTA />
  </div>

  <div id="header-nav" class="h-full flex items-center justify-self-end pr-2 sm:pr-8">
    <Nav />
  </div>

  <NavMenu />
</header>