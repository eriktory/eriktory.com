---
import ButtonCTA from '../Aux/ButtonCTA.astro';
import Logo from './Logo/Logo.astro';
import Nav from './Nav/Nav.astro';
import NavMenu from './Nav/NavMenu.astro';
---

<header class="absolute inset-x-0 top-0 z-30">
  <div class="relative mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto] items-center px-4 pt-4 sm:grid-cols-[1fr_auto_1fr] sm:px-6 sm:pt-8 lg:px-10">
    <div id="header-logo" class="col-start-1 justify-self-start">
      <Logo />
    </div>

    <div id="header-cta" class="hidden sm:col-start-2 sm:flex justify-center">
      <ButtonCTA />
    </div>

    <div id="header-nav" class="col-start-2 sm:col-start-3 justify-self-end">
      <Nav />
    </div>

    <NavMenu />
  </div>
</header>