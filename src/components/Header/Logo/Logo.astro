---
// Logo.astro
import YinYang from '../../../assets/Yin-Yang.png';
---

<div
	id="header-logo"
	class="sm:order-1 sm:justify-self-start self-stretch"
>
	<a href="/" class="inline-flex items-center gap-3.5 group text-decoration-none">
		<img
			src={YinYang}
			alt="Logo Yin-Yang"
			class="h-7 w-auto object-contain relative z-10"
			onerror="this.style.display='none'; this.parentElement.querySelector('.monograma-fallback').style.display='inline-flex';"
		/>
		<!-- Monograma EK como fallback si la imagen no carga -->
		<span
			class="monograma-fallback font-serif font-extrabold text-2xl tracking-tight text-[#0F2851] leading-none"
			style="display:none"
		>
			EK
		</span>

		<!-- Divisor Vertical -->
		<span class="h-7 w-[1px] bg-[#E2E8F0]"></span>

		<!-- Nombre y Subtítulo -->
		<div class="flex flex-col justify-center">
			<span class="text-[0.95rem] font-bold tracking-[0.18em] text-[#0F2851] uppercase leading-tight">
				ERIK TORY
			</span>
			<span class="text-[0.625rem] font-semibold tracking-[0.14em] text-[#64748B] uppercase leading-tight ">
				CONSULTOR ESTRATÉGICO
			</span>
		</div>
	</a>
</div>
