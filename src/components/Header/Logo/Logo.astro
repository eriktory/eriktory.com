---
// Logo.astro
---

<div
	id="header-logo"
	class="p-4 sm:order-1 sm:justify-self-start self-stretch"
>
	<a href="/" class="inline-flex items-center gap-3.5 group text-decoration-none">
		<!-- Monograma EK -->
		<span class="font-serif font-extrabold text-2xl tracking-tight text-[#0F2851] leading-none">
			EK
		</span>

		<!-- Divisor Vertical -->
		<span class="h-7 w-[1px] bg-[#E2E8F0]"></span>

		<!-- Nombre y Subtítulo -->
		<div class="flex flex-col justify-center">
			<span class="text-[0.95rem] font-bold tracking-[0.18em] text-[#0F2851] uppercase leading-tight">
				ERIK TORY
			</span>
			<span class="text-[0.625rem] font-semibold tracking-[0.14em] text-[#64748B] uppercase leading-tight mt-0.5">
				CONSULTOR ESTRATÉGICO
			</span>
		</div>
	</a>
</div>
