---
const navItems = [
  { name: 'Inicio', href: '#top', active: true },
  { name: 'Sobre mí', href: '#sobre-mi', active: false },
  { name: 'Contacto', href: '#contacto', active: false },
];
---

<div
  id="nav-menu"
  class="hidden absolute right-2 top-full z-50 mt-1 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg"
>
  <nav class="flex flex-col gap-1" aria-label="Navegación principal">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={item.active ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-2 text-[0.875rem] transition-colors duration-200 font-sans',
          item.active
            ? 'font-bold text-[#0F2851] bg-slate-100'
            : 'font-medium text-[#475569] hover:bg-slate-100 hover:text-[#0F2851]',
        ]}
      >
        {item.name}
      </a>
    ))}
  </nav>
</div>
