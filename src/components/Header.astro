---
export interface Props {
  title?: string;
}

const { title = 'Mi sitio' } = Astro.props;
---

<header class="sticky top-0 z-50 border-b bg-white/90 backdrop-blur">
  <nav class="max-w-screen-xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      {title}
    </a>

    <div class="space-x-6">
      <a href="/" class="hover:underline">Inicio</a>
      <a href="/about" class="hover:underline">Sobre</a>
      <a href="/contacto" class="hover:underline">Contacto</a>
    </div>
  </nav>
</header>
