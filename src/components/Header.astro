---
import ButtonCTA from '../components/ButtonCTA.astro';
---

<header id="header" class="w-full px-4 py-4 bg-red-500">
	<div id="header-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 items-center w-full">
		<div id="header-logo" class="bg-cyan-500 p-4 sm:order-3 sm:justify-self-end">
			Logo
		</div>

		<div id="header-icon-container" class="bg-magenta-500 p-4 sm:order-1 sm:justify-self-start">
			<svg id="header-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path id="header-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</div>

		<ButtonCTA />
	</div>
</header>
