---
// src/components/Main/Hero/HeroVisualCompass.astro
import { getImage } from 'astro:assets';
import mobileCompass from '../../../assets/HeroImages/hero_01_mv_light.jpg';
import desktopCompass from '../../../assets/HeroImages/light-compass-image.png';

const mobile = await getImage({ src: mobileCompass, format: 'webp', quality: 85 });
const desktop = await getImage({ src: desktopCompass, format: 'webp', quality: 85 });
---

<div class="absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  <div class="relative sm:h-full">
    <picture class="block sm:h-full">
      <source media="(min-width: 640px)" srcset={desktop.src} type="image/webp" />
      <img
        src={mobile.src}
        width={mobile.attributes.width}
        height={mobile.attributes.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full sm:h-full sm:object-cover sm:object-right"
      />
    </picture>

    <!-- Fundido inferior, solo en móvil -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-slate-50 to-transparent sm:hidden"></div>
  </div>
</div>