---
// src/components/Main/Hero/Hero.astro
import HeroTagline from './HeroTagline.astro';
import HeroHeading from './HeroHeading.astro';
import HeroDescription from './HeroDescription.astro';
import HeroButton from './HeroButton.astro';
import HeroVisualCompass from './HeroVisualCompass.astro';
---

<section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-100 py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      <!-- Columna Izquierda: Textos y CTA (Ancho: 7 columnas) -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6">
        <HeroTagline />
        <HeroHeading />
        <HeroDescription />
        <div class="pt-2">
          <HeroButton href="#contacto" />
        </div>
      </div>

      <!-- Columna Derecha: Elemento Visual / Brújula (Ancho: 5 columnas) -->
      <div class="lg:col-span-5 flex justify-center">
        <HeroVisualCompass />
      </div>

    </div>
  </div>
</section>
