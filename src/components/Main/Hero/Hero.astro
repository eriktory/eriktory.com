---
// src/components/Main/Hero/Hero.astro
import HeroTagline from './HeroTagline.astro';
import HeroHeading from './HeroHeading.astro';
import HeroDescription from './HeroDescription.astro';
import HeroButton from './HeroButton.astro';
import HeroVisualCompass from './HeroVisualCompass.astro';
---

<section class="relative w-full overflow-hidden min-h-[700px] lg:min-h-[900px]">
	<HeroVisualCompass />

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center h-full">
			<!-- Columna Izquierda: Textos y CTA (Ancho: 7 columnas) -->
			<div class="lg:col-span-7 flex flex-col items-start space-y-6 h-full justify-center py-16 lg:py-24">
				<HeroTagline />
				<HeroHeading />
				<HeroDescription />
				<div class="pt-2">
					<HeroButton href="#contacto" />
				</div>
			</div>

			<!-- Columna Derecha: reservada (el fondo cubre toda la sección) -->
			<div class="lg:col-span-5"></div>
		</div>
	</div>
</section>
